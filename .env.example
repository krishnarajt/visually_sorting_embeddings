# ---------------------------------------------------------------------------
# visually sorting embeddings
#
# Only the two API keys have no usable default. Everything else can stay as it
# is.
# ---------------------------------------------------------------------------

# The OpenAI key, used for the two text-embedding-3 sources. Without it those
# two are greyed out in the UI with the reason shown, and the GloVe source —
# which runs entirely locally and is the one the king - man + woman arithmetic
# works on — is unaffected. Named OPENAI_KEY to match the other repos here;
# OPENAI_API_KEY is also accepted.
OPENAI_KEY=sk-...

# Point at a compatible proxy to route the embedding calls somewhere else.
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Cohere
#
# Used by the one source, embed-multilingual-v3.0 — 1024 dimensions over 100+
# languages. Same deal as the OpenAI key: without it that source and its
# translated twin are greyed out with the reason shown, and nothing else
# changes. COHERE_API_KEY is also accepted.
# ---------------------------------------------------------------------------
COHERE_KEY=...
COHERE_BASE_URL=https://api.cohere.com/v2

# Texts per /v2/embed call. 96 is the API's documented maximum and the value is
# clamped to it, so raising this does nothing — it is here to be lowered.
COHERE_BATCH_SIZE=96

# ---------------------------------------------------------------------------
# The translate-to-English indexes
#
# Every model has a `<id>-via-en` twin that embeds the English translation of
# the text rather than the text. The built-in word sets carry their own exact
# translations, so those twins work with no key at all; this model only gets
# called for words you type yourself. Answers are cached to
# data/translations.json so a reload costs nothing and two exports agree.
# ---------------------------------------------------------------------------
TRANSLATE_MODEL=gpt-4o-mini
TRANSLATE_BATCH_SIZE=48
TRANSLATE_TIMEOUT=60

# ---------------------------------------------------------------------------
# GloVe
#
# Not shipped in git: it is 55 MB. Build it once with
#   python scripts/fetch_glove.py
# which downloads Stanford's 820 MB glove.6B.zip, keeps the 50,000 most
# frequent words of the 300-d file, and deletes the download afterwards.
# ---------------------------------------------------------------------------
GLOVE_FILE=glove.6B.300d.npz
DATA_DIR=./data

# ---------------------------------------------------------------------------
# The local multilingual encoders
#
# LaBSE, paraphrase-multilingual-MiniLM and multilingual-e5-small, run on ONNX
# Runtime. Not shipped in git: 2.8 GB. Fetch them once with
#   python scripts/fetch_models.py
# and until you do, those three sources report themselves unavailable with that
# command in the message rather than downloading mid-request. A Hugging Face
# cache of our own under data/ rather than ~/.cache, so deleting the project
# deletes the weights.
# ---------------------------------------------------------------------------
MODELS_DIR=models

# Texts per forward pass on the CPU encoders. Bounded by latency, not an API.
LOCAL_BATCH_SIZE=32

# How many words one projection may contain. t-SNE runs synchronously inside
# the request and the browser has to draw the result, so this protects both.
MAX_WORDS=2000

# Seeded so t-SNE and UMAP give the same picture for the same words twice.
# Change it to see how much of a layout was arbitrary.
RANDOM_SEED=42

# Words per OpenAI request, and how long to wait for either API. Cohere has its
# own batch size above, because 96 is a hard limit there rather than a
# preference.
EMBED_BATCH_SIZE=128
EMBED_TIMEOUT=30

# Projections are cached by (source, method, words, params). This is how many.
PROJECTION_CACHE_SIZE=128

# CORS. The Vite dev server defaults to 1186 for this project. The deployed
# API sets this to * — it has no accounts or cookies, and the UI's Vercel and
# Netlify URLs differ on every pull request. A wildcard turns credentialed
# requests off; named origins keep them on.
CORS_ORIGINS=http://localhost:1186,http://localhost:5174,http://localhost:5173

# Requests per rolling minute per client over /api/*. 0 is off, which is right
# for a laptop. The deployed API sets 120: there is no login in front of the
# OpenAI and Cohere keys, so this is what stands between the internet and the
# bill. Clients are told apart by CF-Connecting-IP. See app/ratelimit.py.
RATE_LIMIT_PER_MINUTE=0

LOG_LEVEL=INFO
PORT=1184
RELOAD=false
